# LLM backend: "mock" (default, offline, no key needed), "anthropic", or "openai"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding backend: "local" (offline TF-IDF+SVD, default) or "sentence-transformers"
EMBEDDING_BACKEND=local
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Reranker backend: "lexical" (offline, default) or "cross-encoder"
RERANK_BACKEND=lexical
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval
TOP_K_SPARSE=15
TOP_K_DENSE=15
TOP_K_FUSED=10
TOP_K_FINAL=5

# Paths
CORPUS_DIR=data/corpus
INDEX_DIR=data/index
