# LLM backend: "mock" (default, offline, no key needed), "anthropic", or "openai"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding backend: "local" (offline TF-IDF+SVD, default) or "sentence-transformers"
EMBEDDING_BACKEND=local
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Reranker backend: "lexical" (offline, default) or "cross-encoder"
RERANK_BACKEND=lexical
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval
TOP_K_SPARSE=15
TOP_K_DENSE=15
TOP_K_FUSED=10
TOP_K_FINAL=5

# Paths
CORPUS_DIR=data/corpus
INDEX_DIR=data/index

# --- Project B: reconciliation agent (reconagent) ---
# Policy driving the loop: "rules" (offline, deterministic, $0 — default),
# "naive" (the eval floor), or "anthropic" (real model, needs a key).
AGENT_POLICY=rules
AGENT_MODEL=claude-sonnet-5

# Loop bounds. Every one of these ends the episode in an escalation, never
# in an exception silently left open.
AGENT_MAX_STEPS=14
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_TOOL_ERRORS=6
AGENT_MAX_COST_USD=0.25
AGENT_MAX_WALL_CLOCK_S=90
AGENT_TOOL_MAX_ATTEMPTS=3
AGENT_TOOL_BACKOFF_BASE_S=0.05

# Deterministic world + fault injection for the eval harness.
AGENT_WORLD_SEED=20260301
AGENT_FAULT_RATE=0.12
AGENT_EVAL_DIR=eval/agent
